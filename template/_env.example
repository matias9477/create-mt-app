# Copy to .env and fill in. Only EXPO_PUBLIC_* vars are readable from app code.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# AdMob banner ad unit ids (ca-app-pub-.../...). Empty = ads disabled on that platform.
EXPO_PUBLIC_ADMOB_BANNER_IOS=
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
